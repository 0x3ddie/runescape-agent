diff --git a/server/engine/src/engine/World.ts b/server/engine/src/engine/World.ts
index 5b889d7b4..59e13225b 100644
--- a/server/engine/src/engine/World.ts
+++ b/server/engine/src/engine/World.ts
@@ -109,10 +109,18 @@ type LogoutRequest = {
     lastAttempt: number;
 };
 
+// rs-sdk-rl debug: surface real worker errors (Bun otherwise prints an opaque
+// ErrorEvent object and the world dies with "Worker has been terminated").
+function instrumentWorker(w: Worker, name: string): Worker {
+    w.on('error', (err: unknown) => console.error(`[worker:${name}] ERROR`, err));
+    w.on('exit', (code: number) => { if (code !== 0) console.error(`[worker:${name}] EXIT code=${code}`); });
+    return w;
+}
+
 class World {
-    private loginThread = new Worker(new URL('../server/login/LoginThread.ts', import.meta.url));
-    private friendThread = new Worker(new URL('../server/friend/FriendThread.ts', import.meta.url));
-    private loggerThread = new Worker(new URL('../server/logger/LoggerThread.ts', import.meta.url));
+    private loginThread = instrumentWorker(new Worker(new URL('../server/login/LoginThread.ts', import.meta.url)), 'login');
+    private friendThread = instrumentWorker(new Worker(new URL('../server/friend/FriendThread.ts', import.meta.url)), 'friend');
+    private loggerThread = instrumentWorker(new Worker(new URL('../server/logger/LoggerThread.ts', import.meta.url)), 'logger');
     private devThread: Worker | null = null;
 
     private static readonly PLAYERS: number = 2047;
