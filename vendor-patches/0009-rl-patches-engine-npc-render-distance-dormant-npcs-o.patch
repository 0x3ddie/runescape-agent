             try {
                 if (this.lifecycle === EntityLifeCycle.RESPAWN) {
@@ -148,6 +142,34 @@ export default class Npc extends PathingEntity {
                 this.setLifeCycle(1);
             }
         }
+    }
+
+    /**
+     * The tick an npc gets when no player is inside World.npcActiveRadius of it.
+     *
+     * Skips hunt, regen, timers, queues, movement and facing — everything whose
