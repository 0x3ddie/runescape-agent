 server/engine/src/engine/World.ts      | 49 ++++++++++++++++++++++++++
 server/engine/src/engine/entity/Npc.ts | 46 +++++++++++++++++-------
 2 files changed, 83 insertions(+), 12 deletions(-)

diff --git a/server/engine/src/engine/World.ts b/server/engine/src/engine/World.ts
index 59e13225b..a574a55b3 100644
--- a/server/engine/src/engine/World.ts
+++ b/server/engine/src/engine/World.ts
@@ -715,10 +715,59 @@ class World {
     // - queue
     // - movement
     // - modes
+    /**
+     * Render distance for npc simulation, in tiles. 0 disables the gate and the
+     * world behaves exactly as it did before (vanilla).
+     *
+     * Why this exists: a world cycles every static npc every tick whether or not
+     * anybody can see it. Measured idle, 2.03 ms of a 2.88 ms cycle — 71% — went
+     * to 7,321 npcs, of which an agent within its 52-tile scan can see roughly 50.
+     * That cost is paid by every world process, so it set the ceiling on how many
+     * honest worlds this machine could run.
+     *
+     * The radius MUST stay >= the agent's npc scan radius (env-ts/engine/observe.ts
+     * NPC_SCAN_TILES = 52) or agents would observe frozen npcs. Default 64 leaves
+     * a 12-tile margin so an npc still moves for a tick or two after it leaves the
+     * observation window.
+     */
+    private static readonly NPC_ACTIVE_RADIUS: number = parseInt(process.env.RL_NPC_RADIUS ?? '64', 10);
+
+    /**
+     * The 64x64 chunks that hold at least one player, dilated by NPC_ACTIVE_RADIUS.
+     * Returns null when the gate is off. Cost is O(players), against O(npcs) for
+     * the loop it guards, and each npc then pays one integer hash lookup.
+     */
+    private activeNpcChunks(): Set<number> | null {
+        const r: number = World.NPC_ACTIVE_RADIUS;
+        if (r <= 0) {
+            return null;
+        }
+        const active: Set<number> = new Set();
+        for (const player of this.playerLoop.all()) {
+            const cx0: number = (player.x - r) >> 6;
+            const cx1: number = (player.x + r) >> 6;
+            const cz0: number = (player.z - r) >> 6;
+            const cz1: number = (player.z + r) >> 6;
+            for (let cx: number = cx0; cx <= cx1; cx++) {
+                for (let cz: number = cz0; cz <= cz1; cz++) {
+                    active.add((player.level << 20) | (cx << 10) | cz);
+                }
+            }
+        }
+        return active;
+    }
+
     private processNpcs(): void {
         const start: number = Date.now();
+        const active: Set<number> | null = this.activeNpcChunks();
         for (const npc of this.npcs) {
             try {
+                if (active !== null && !active.has((npc.level << 20) | ((npc.x >> 6) << 10) | (npc.z >> 6))) {
+                    // Out of render distance: lifecycle only, so a killed npc still
+                    // respawns while nobody is there to watch it happen.
+                    npc.dormantTurn();
+                    continue;
+                }
                 npc.turn();
             } catch (err) {
                 console.error(err);
